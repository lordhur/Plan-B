# ============================================================
# PlanB — Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs
# ============================================================

# --- Base de données PostgreSQL ---
# Local (PGlite) : postgresql://planb:planb@127.0.0.1:5433/planb  (npm run db:local)
# Production (Supabase) : l'URL de connexion "Transaction pooler"
DATABASE_URL="postgresql://planb:planb@127.0.0.1:5433/planb"
# Supabase : URL de connexion "Session pooler" (pour les migrations)
DIRECT_URL="postgresql://planb:planb@127.0.0.1:5433/planb"

# --- Auth PlanB (JWT sessions) ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-random-secret"

# --- Supabase (optionnel — l'auth PlanB intégrée fonctionne sans) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe (Phase 4 — billetterie) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (Resend — gratuit, 100 e-mails/jour / 3 000 par mois) ---
# Sans cette clé, AUCUN e-mail ne part : les codes de vérification sont alors
# affichés directement dans l'interface (rien ne bloque). Voir docs/oauth-setup.md.
RESEND_API_KEY=""
# Domaine vérifié chez Resend. Tant que le domaine n'est pas vérifié, Resend
# n'autorise l'envoi que vers l'adresse du compte Resend lui-même.
EMAIL_FROM="PlanB <onboarding@resend.dev>"

# --- Connexion sociale (OAuth) ---
# Guide pas à pas : docs/oauth-setup.md
# Google — console.cloud.google.com → API et services → Identifiants
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook — developers.facebook.com → votre app → Connexion Facebook → Paramètres
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Instagram — developers.facebook.com → votre app → Instagram → API avec connexion Instagram
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# --- Web Push (Phase 2+) ---
# Générer avec : npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# --- Protection cron jobs (Vercel Cron) ---
CRON_SECRET=""
