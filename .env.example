# ============================================================
# PlanB — Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs
# ============================================================

# --- Base de données PostgreSQL ---
# Local (PGlite) : postgresql://planb:planb@127.0.0.1:5433/planb  (npm run db:local)
# Production (Supabase) : l'URL de connexion "Transaction pooler"
DATABASE_URL="postgresql://planb:planb@127.0.0.1:5433/planb"
# Supabase : URL de connexion "Session pooler" (pour les migrations)
DIRECT_URL="postgresql://planb:planb@127.0.0.1:5433/planb"

# --- Auth PlanB (JWT sessions) ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-random-secret"

# --- Supabase (optionnel — l'auth PlanB intégrée fonctionne sans) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe (Phase 4 — billetterie) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (Resend, 3000 emails/mois gratuits) ---
# Si vide, les codes de vérification sont affichés dans les logs serveur (mode dev)
RESEND_API_KEY=""
EMAIL_FROM="PlanB <onboarding@planb.app>"

# --- Web Push (Phase 2+) ---
# Générer avec : npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# --- Protection cron jobs (Vercel Cron) ---
CRON_SECRET=""
